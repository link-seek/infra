{
	"groups": {"group:admin": ["xieyucheng123@github"]},
	"tagOwners": {
		"tag:mesh":      ["autogroup:admin"],
		"tag:connector": ["autogroup:admin"],
		// S1 三权拆分（#202）：guest=访客（bake/preflight/probe 靶机，全网可达不可登录）；
		// user=配送（deliver/deliver-caddy，可达＋可登点名生产机）；admin=值班（全网，手动）。
		"tag:guest":     ["autogroup:admin"],
		"tag:user":      ["autogroup:admin"],
		"tag:admin":     ["autogroup:admin"],
		// 常驻生产机（hw-21）。
		"tag:prod":      ["autogroup:admin"],
		// 机器专属 tag（#202 修正案：tag 精确到单机，node_ip 降为防呆）。
		"tag:opencode-hw21": ["autogroup:admin"],
		"tag:opencode-hw41": ["autogroup:admin"],
		// opencode-prod 容器（userspace tailscaled），独立 tailnet 节点。
		"tag:opencode":  ["autogroup:admin"],
		// litellm-gateway 容器（userspace tailscaled，不开 --ssh），独立 tailnet 节点（#181）。
		"tag:gateway":   ["autogroup:admin"]
	},
	"autoApprovers": {"routes": {"0.0.0.0/0": ["tag:connector"], "::/0": ["tag:connector"]}},
	"grants": [
		{
			"src": ["tag:mesh"],
			"dst": ["100.91.222.51", "100.85.128.116", "100.69.220.112", "100.111.231.85"],
			"ip":  ["22", "41641"]
		},
		{"src": ["tag:mesh"], "dst": ["100.91.222.51"], "ip": ["4097"]},
		// k3s 跨云 agent（#373 终局）：mesh 系节点（含边缘 agent）调 k3s server 6443（agent 主动建连方向；回包 stateful 放行）。
		// 直连 UDP 41641 提速（DERP 兜底，不断连）。IP 写死已死（41/.69 重建换 IP 即失联），改走 tag:prod。
		{"src": ["tag:mesh"], "dst": ["tag:prod"], "ip": ["6443", "41641"]},
		// yingxin：ali-gz Caddy（tag:mesh）反代 hw41:4097（opencode-prod-ali-gz 落点）。
		{"src": ["tag:mesh"], "dst": ["100.111.231.85"], "ip": ["4097"]},
		{"src": ["tag:mesh"], "dst": ["100.111.231.85"], "ip": ["2222"]},
		// demo：ali-gz Caddy（tag:mesh）直打 demo 容器身份 :8788（cloudflare-os 试用，转正即删）。
		{"src": ["tag:mesh"], "dst": ["tag:opencode"], "ip": ["8788"]},
		{"src": ["tag:mesh"], "dst": ["tag:connector"], "ip": ["*"]},
		{"src": ["autogroup:member"], "dst": ["tag:connector"], "ip": ["*"]},
		{"src": ["autogroup:member"], "dst": ["100.91.222.51"], "ip": ["4000"]},
		{"src": ["tag:mesh"], "dst": ["100.91.222.51"], "ip": ["4000"]},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:mesh", "tag:connector", "100.69.220.112/32", "100.78.144.89/32"],
			"ip":  ["*"]
		},
		{"src": ["autogroup:admin"], "dst": ["*"], "ip": ["*"]},
		{
			"src": ["tag:mesh"],
			"dst": ["autogroup:internet"],
			"via": ["tag:connector"],
			"ip":  ["*"]
		},
		{"src": ["tag:mesh"], "dst": ["100.91.222.51"], "ip": ["4098"]},
		{"src": ["autogroup:member"], "dst": ["100.91.222.51"], "ip": ["4098"]},
		// 过渡期 2244 保留：旧 key 通路还在，切完 TS SSH 并验证后删掉 2244。
		// S1 三权拆分（#202）：guest 全网可达（服务/网关/拉包/探端口），不可登录；user 点名生产机。
		{"src": ["tag:guest"], "dst": ["100.91.222.51", "100.85.128.116", "100.111.231.85", "100.103.182.112", "100.69.220.112", "100.78.144.89"], "ip": ["*"]},
		{"src": ["tag:guest"], "dst": ["tag:guest"], "ip": ["*"]},
		{"src": ["tag:guest"], "dst": ["tag:opencode"], "ip": ["22"]},
		{"src": ["tag:guest"], "dst": ["100.91.222.51"], "ip": ["4000"]},
		{"src": ["tag:user"], "dst": ["tag:prod"], "ip": ["22", "2244"]},
		{"src": ["tag:user"], "dst": ["tag:opencode-hw21", "tag:opencode-hw41"], "ip": ["22", "2244"]},
		{"src": ["tag:user"], "dst": ["100.91.222.51"], "ip": ["4000"]},
		{"src": ["tag:user"], "dst": ["tag:user"], "ip": ["22", "2244"]},
		{"src": ["tag:user"], "dst": ["tag:guest"], "ip": ["22", "2244"]},
		{"src": ["tag:user"], "dst": ["tag:opencode"], "ip": ["22"]},
		// k3s-apply ingress 探针（Caddy 视角）：配送 runner 直连 pod :4097（HTTP，无 ssh）。
		// 只给网络可见性+4097；canary 探针同款（74 行注释）。
		{"src": ["tag:user"], "dst": ["tag:opencode"], "ip": ["4097"]},
		{"src": ["tag:user"], "dst": ["100.111.231.85"], "ip": ["22", "2244"]},
		// 非 HW（ali-gz/oci）只放 admin：deliver-caddy 以 admin 身份上机（手动 dispatch＋全程盯）。
		{"src": ["tag:admin"], "dst": ["100.85.128.116"], "ip": ["22"]},
		// 网关独立入网（#181/#202）：网关 :4000 全网放行（公共基础设施，认证由网关自己管）。
		{"src": ["tag:mesh", "tag:opencode", "tag:user", "tag:guest", "autogroup:member"], "dst": ["tag:gateway"], "ip": ["4000"]},
		// opencode-prod 容器只登 .21/.41 两个等价节点；人（tag:mesh）可登容器排障。
		{"src": ["tag:opencode"], "dst": ["100.91.222.51", "100.111.231.85"], "ip": ["22"]},
		{"src": ["tag:mesh"],     "dst": ["tag:opencode"], "ip": ["22"]},
		// 入口 Caddy（mesh）到 opencode 系容器 4097；现有 mesh→opencode:22 不动。
		{"src": ["tag:mesh"], "dst": ["tag:opencode"], "ip": ["4097"]},
		// CI 看 canary：trial 靶机/runner 按各自身份（guest/user），netmap 按 ACL 过滤，
		// 无此条则探针在宿主设备表永远看不到 canary（40616506188/40617554410 实锤）。
		// 只给网络可见性，不给 ssh 规则（探针用 docker exec），CI 不能 SSH 进 canary。
		// deliver-stack 一次性节点（guest/user）上 hw41 部署，2244 上机 + 22 备用。
	],
	"nodeAttrs": [{"target": ["*"], "app": {"tailscale.com/app-connectors": [{
		"name":       "opencode-ai",
		"connectors": ["tag:connector"],
		"domains":    ["opencode.ai", "*.opencode.ai"]
	}, {"name": "huggingface", "connectors": ["tag:connector"], "domains": [
		"huggingface.co",
		"*.huggingface.co",
		"hf.co",
		"*.hf.co",
		"hf.space",
		"*.hf.space",
		"huggingface.com",
		"*.huggingface.com",
		"huggingface.cn",
		"*.huggingface.cn"
	]}, {"name": "dev-tools", "connectors": ["tag:connector"], "domains": [
		"github.com",
		"*.githubusercontent.com",
		"github-cloud.s3.amazonaws.com",
		"pypi.org",
		"*.pypi.org",
		"pypi.python.org",
		"pythonhosted.org",
		"*.pythonhosted.org",
		"npmjs.org",
		"*.npmjs.org",
		"npmjs.com",
		"*.npmjs.com",
		"yarnpkg.com",
		"*.yarnpkg.com",
		"docker.io",
		"*.docker.io",
		"docker.com",
		"*.docker.com",
		"ghcr.io",
		"quay.io",
		"registry.k8s.io"
	]}, {"name": "google", "connectors": ["tag:connector"], "domains": [
		"google.com",
		"*.google.com",
		"googleapis.com",
		"*.googleapis.com",
		"gstatic.com",
		"*.gstatic.com",
		"google.com.hk",
		"*.google.com.hk"
	]}]}}],
	"ssh": [{
		"action": "check",
		"src":    ["autogroup:member"],
		"dst":    ["autogroup:self"],
		"users":  ["autogroup:nonroot", "root"]
	}, {
		// S1 三权拆分（#202）：guest 只互登，user 可登 guest 临时靶机＋点名生产机，admin 全网。
		"action": "accept",
		"src":    ["tag:guest"],
		"dst":    ["tag:guest"],
		"users":  ["root"]
	}, {
		"action": "accept",
		"src":    ["tag:user"],
		"dst":    ["tag:prod"],
		"users":  ["root"]
	}, {
		"action": "accept",
		"src":    ["tag:user"],
		"dst":    ["tag:user"],
		"users":  ["root"]
	}, {
		// user 可登 guest 临时测试靶机＋点名生产机。
		"action": "accept",
		"src":    ["tag:user"],
		"dst":    ["tag:guest"],
		"users":  ["root"]
	}, {
		// user 登 mesh（HW 点名机经 grants 交集收窄；ali-gz/oci 无 user grants，到不了）。
		"action": "accept",
		"src":    ["tag:user"],
		"dst":    ["tag:mesh"],
		"users":  ["root"]
	}, {
		"action": "accept",
		"src":    ["tag:admin"],
		"dst":    ["tag:mesh"],
		"users":  ["root"]
	}, {
		"action": "accept",
		"dst":    ["tag:prod"],
		"users":  ["root"]
	}, {
		// opencode-prod 容器：SSH dst 不能用 IP，用 tag:mesh；上面的网络 grant
		// 只放行 .21/.41:22，二者交集才是真正可达的两台等价节点。
		"action": "accept",
		"src":    ["tag:opencode"],
		"dst":    ["tag:mesh"],
		"users":  ["root"]
	}, {
		"action": "accept",
		"src":    ["tag:mesh"],
		"dst":    ["tag:opencode"],
		"users":  ["root"]
	}, {
		// 已删 autogroup:member → tag:mesh / tag:connector：
		// 那是"任何未打 tag 的成员设备都能 root 进所有机器"，包括随便起的 CI 节点。
		// 人的设备都是 tag:mesh，走下面这条，能力不受影响。
		"action": "accept",
		"src":    ["tag:mesh"],
		"dst":    ["tag:mesh"],
		"users":  ["root"]
	}, {
		"action": "accept",
		"src":    ["tag:mesh"],
		"dst":    ["tag:mesh"],
		"users":  ["opencode-gate"]
	}, {
		"action": "accept",
		"src":    ["tag:mesh"],
		"dst":    ["tag:connector"],
		"users":  ["root"]
	}],

	"tests": [
		{"src": "tag:mesh", "allow": ["100.85.128.116:22"]},
		{"src": "tag:mesh", "allow": ["100.69.220.112:22"]},
		{"src": "tag:mesh", "allow": ["100.91.222.51:22"]},
		{"src": "tag:mesh", "allow": ["100.111.231.85:22"]},
		{"src": "tag:mesh", "allow": ["100.103.182.112:22"]},
		{
			"src":   "xieyucheng123@github",
			"allow": ["100.85.128.116:22", "100.91.222.51:22"]
		},
		{"src": "tag:mesh", "allow": ["20.27.177.113:443"]},
		// hw41 已定为生产后端，CI 上机需要；原 deny 意图见 git 历史。
		// 非 HW 只放 admin：deliver-caddy 身份（手动 dispatch＋全程盯）。
		{"src": "tag:admin", "allow": ["100.85.128.116:22"]},
		{"src": "tag:opencode", "allow": ["100.91.222.51:22", "100.111.231.85:22"]},
		{"src": "tag:opencode", "deny": ["100.85.128.116:22", "100.69.220.112:22"]}
	]
}
