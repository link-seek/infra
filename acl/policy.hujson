{
	"groups": {"group:admin": ["xieyucheng123@github"]},
	"tagOwners": {
		"tag:hw":     ["autogroup:admin"],
		"tag:ali":    ["autogroup:admin"],
		"tag:oci":    ["autogroup:admin"],
		"tag:github": ["autogroup:admin"],
		"tag:pc":     ["autogroup:admin"]
	},
	"grants": [
		// 集群内网：hw/ali/oci 均为自有 k3s 节点，全端口互通。
		// 覆盖 underlay VXLAN(udp 8472)/apiserver(6443)/etcd(2379-2380)/kubelet(10250)/Tokyo 中继(14443) 等。
		{"src": ["tag:hw", "tag:ali", "tag:oci"], "dst": ["tag:hw", "tag:ali", "tag:oci"], "ip": ["*"]},
		// 个人电脑：最高权限，可达集群与其它个人电脑。
		{"src": ["tag:pc"], "dst": ["tag:hw", "tag:ali", "tag:oci", "tag:pc"], "ip": ["*"]},
		// CI deploy runner（tag:github，仅它进网）：自有节点全端口（部署/校验/etcd obs 等）。
		{"src": ["tag:github"], "dst": ["tag:hw", "tag:ali", "tag:oci"], "ip": ["*"]},
		// home-oc：云节点(hw/ali/oci) 反向访问个人 PC(tag:pc) 的 opencode :4096（仅该端口）。
		{"src": ["tag:hw", "tag:ali", "tag:oci"], "dst": ["tag:pc"], "ip": ["4096"]},
		// 管理员安全网（人类 admin 任何时候可达全部，防锁死）。
		{"src": ["autogroup:admin"], "dst": ["tag:hw", "tag:ali", "tag:oci", "tag:github", "tag:pc"], "ip": ["*"]}
	],
	"ssh": [
		// 个人电脑 root 登集群（tagged 只能用 accept，不能用 check）。
		{"action": "accept", "src": ["tag:pc"], "dst": ["tag:hw", "tag:ali", "tag:oci"], "users": ["root"]},
		// CI deploy runner root 登节点（节点开 Tailscale SSH）。
		{"action": "accept", "src": ["tag:github"], "dst": ["tag:hw", "tag:ali", "tag:oci"], "users": ["root"]},
		// 节点间 root ssh：edge-join 的“跳板 server → 目标 edge”架构需要（节点已全端口互通，同信任模型）。
		{"action": "accept", "src": ["tag:hw", "tag:ali", "tag:oci"], "dst": ["tag:hw", "tag:ali", "tag:oci"], "users": ["root"]},
		// 管理员安全网。
		{"action": "accept", "src": ["autogroup:admin"], "dst": ["tag:hw", "tag:ali", "tag:oci", "tag:github", "tag:pc"], "users": ["root"]},
		// 成员自己的设备互登（check）。
		{"action": "check", "src": ["autogroup:member"], "dst": ["autogroup:self"], "users": ["autogroup:nonroot", "root"]}
	],
	"tests": [
		{"src": "tag:hw", "allow": ["100.73.182.4:8472", "100.93.119.21:6443", "100.85.128.116:6443"]},
		{"src": "tag:hw", "allow": ["100.73.221.121:14443"]},
		{"src": "tag:pc", "allow": ["100.100.246.95:22", "100.73.182.4:22", "100.93.119.21:22"]},
		{"src": "tag:github", "allow": ["100.100.246.95:22", "100.73.182.4:6443"]},
		{"src": "tag:hw", "allow": ["100.85.128.116:22"]},
		{"src": "tag:ali", "allow": ["100.69.220.112:4096"]}
	]
}
