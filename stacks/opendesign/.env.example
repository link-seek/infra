# opendesign .env 键位表（占位符，无真值）
# 真值来源（按 house flow）：sops 密文（HW21 为收件人），目标机落盘 600。
# 部署 workflow 只下发本目录 compose/README，本文件仅供对照。目标机缺 .env 时 deploy 直接 abort。
# 键位与现网一一对应（2026-10-16 取证：compose environment 3 个＋.env 2 个）：
OD_API_TOKEN=<OD 登录口令，sops；现网 compose 明文，收编改引用>
OD_ALLOWED_ORIGINS=https://opendesign.xieyucheng.top
OD_ALLOWED_INTERNAL_HOSTS=100.91.222.51
LITELLM_BASE_URL=http://100.91.222.51:4000
LITELLM_API_KEY=<网关 master key，sops>
