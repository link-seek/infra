# 生产 .env 键位表（占位符，无真值）
# 真值来源（按 house flow）：
#   1) sops 密文：xieyucheng123/opencode-secrets `envs/opencode-prod.sops.env`（主）
#   2) 目标机本地文件：config/home/.aliyun/、config/home/.oci/（永不进 git，workflow 也不碰）
# 部署 workflow 只下发 compose/README，本文件仅供对照。目标机缺 .env 时 workflow 直接 abort。
LITELLM_BASE_URL=http://100.91.222.51:4000
LITELLM_API_KEY=<网关 master key，sops>
GH_TOKEN=<ghp，sops>
OPENCODE_SERVER_PASSWORD=<Web 登录密码，sops>
CLOUDFLARE_API_TOKEN=<DNS token，sops>
CF_AI_TOKEN=<embedding key，org secret CF_AI_TOKEN 直供 render（旧补齐步骤已退役）>
HCLOUD_AK=<sops>
HCLOUD_SK=<sops>
TS_JOIN_KEY=<deliver 现场 mint 的 tailnet auth key，reusable+ephemeral+90d，tag:opencode>
SSH_TARGETS=<tailnet hostname，如 "mesh-hw-21 mesh-hw-41">
SMTP_HOST=<如 smtp.163.com>
SMTP_PORT=<如 465>
SMTP_USER=<sops>
SMTP_PASS=<sops>
SMTP_FROM=<发件地址>
MAIL_DEFAULT_TO=xieyucheng@outlook.com
BROWSER_CDP_URL=http://172.17.0.1:9222
PIPELINE_MANAGED=true
