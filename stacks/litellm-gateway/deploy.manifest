# stacks/litellm-gateway/deploy.manifest — 快递形状声明（deliver-stack.yml 复用线读取）
REMOTE_DIR=/root/stacks/litellm-gateway
ENV_CONF=env-sources.conf
# pin 冻结：compose 里这些 repo 的 @sha256 会被候选 digest 替换
PIN_REPOS="swr.cn-north-9.myhuaweicloud.com/linkseed/litellm-gateway"
# 同步到目标机的文件（相对栈目录；.env 另走 render+scp，不在此列）。
# 注意：config/guard 不在此列——compose 零挂载，靶机上的拷贝无人读取（读执行以 canary 内 bake 的为准）；
# 探针要的黑名单从运行中的 canary 现场取，不读同步拷贝。
SYNC_FILES="compose.yml README.md .env.example goss-gateway.yaml probe-cases"
# 探针 goss 版本（deliver-remote-core.sh 在 CI 下载后按同一条 tar 路送上靶机，不烘镜像）
GOSS_VERSION="v0.4.10"
# 切流时重建的服务（canary 已验过，留下同样内容）
CUTOVER_SERVICES="litellm-guard"
# 生产 up 探针级别：full（就绪+黑名单+goss pin/verdict 透传全套）
UP_PROBE_LEVEL="full"

# ---- 共用 canary 三件套参数（scripts/canary-run/probe/drop.sh 固定函数）----
CANARY_PROJECT=litellm-guard-canary
CANARY_CONTAINER=litellm-guard-canary
# service|container_name|宿主端口(逗号分隔)|hostname|env(K=V;...)|network
# 网关不暴露宿主端口，并切到 canary 自有网络（避免挂生产具名网络）。
CANARY_SERVICE_SPECS="litellm-guard|litellm-guard-canary||||canary-net"
CANARY_UP_SERVICES="litellm-guard"
CANARY_IMAGE_MATCH=linkseed/litellm-gateway
CANARY_MASTER_FILE=.canary_master
# 真/假 key 探针模型留在 probe-cases/goss；黑名单从运行中的 canary 现场取。
CANARY_PINS="PIN_GATEWAY=linkseed/litellm-gateway"
CANARY_BLACKLIST_PATH=/app/models-denied.json
GOSS_FILE=goss-gateway.yaml
GOSS_RETRY_TIMEOUT=180s
# goss 用例下限（现 3 条：http1+command2）；防删门禁
MIN_GOSS_CASES=3
