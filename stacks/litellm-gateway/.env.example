# litellm-gateway .env 键位表（占位符，无真值）
# 真值来源（按 house flow）：sops 密文（opencode-secrets，HW21 为收件人）。
# 部署 workflow 只下发本目录文件，本文件仅供对照。目标机缺 .env 时 verify 直接 abort。
GO_BACKEND_KEY=<上游 go 后端 key，sops>
LITELLM_MASTER_KEY=<网关 master key，只以 env 注入，sops>
RULES_URL=<R2 规则地址，可空；挂了就摘掉切文件模式>
RULES_REFRESH_SEC=60
VAULT_SALT_ROTATE_SEC=86400
GATEWAY_DEFAULT_SESSION=gateway-default-v1
MODELS_DENIED_FILE=/app/models-denied.json
