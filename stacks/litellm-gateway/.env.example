# litellm-gateway .env 键位表（2026-11-02 加 TS_JOIN_KEY：deliver 现场 mint，容器 userspace tailscaled 启动时 join）
# TS_JOIN_TAG 仅 deliver 侧读（决定 mint 哪个 tag），容器忽略。
TS_JOIN_KEY=<deliver 现场 mint 的 tailnet auth key，reusable+ephemeral+90d，tag:gateway>
TS_JOIN_TAG=tag:gateway
DISABLE_ADMIN_UI=True
PIPELINE_MANAGED=true
RULES_FILE=/app/guard-rules.json
RULES_URL=https://pub-d34014c070294990b0822c30aeca4dea.r2.dev/rules.json
