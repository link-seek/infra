#!/bin/bash
# healthcheck — 网关镜像自带健康检查（固定函数契约，部署线盲调）。
#
# 接口（部署线拥有，实现随镜像，改查同 digest）：
#   healthcheck --base-url <http://ip:port> --api-key <key> --level <boot|full>
#     [--container <name>] [--denied-file <path>]
#   exit 0 + "PROBE OK"              -> 可用
#   exit 非零 + "FAIL: ..."          -> 不可用
#   --level boot = 就绪 + 黑名单（轻链路）；full = 再加真假 key 上游 verdict。
#   --denied-file 缺省为脚本同目录 models-denied.json（随镜像一起 extract，无外部路径泄漏）。
#   --container 缺省不 dump 日志；给了则失败时 tail 该容器日志（名字由 canary-run 的
#   "canary container: <name>" 行透传，部署线只做字符串搬运，不感知含义）。
set -euo pipefail

BASE_URL=""; API_KEY=""; LEVEL="full"; CONTAINER=""; DENIED_FILE=""
usage() { echo "usage: healthcheck --base-url URL --api-key KEY [--level boot|full] [--container NAME] [--denied-file PATH]" >&2; exit 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    --base-url) BASE_URL="${2:-}"; shift 2 ;;
    --api-key) API_KEY="${2:-}"; shift 2 ;;
    --level) LEVEL="${2:-}"; shift 2 ;;
    --container) CONTAINER="${2:-}"; shift 2 ;;
    --denied-file) DENIED_FILE="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "unknown arg: $1" >&2; usage ;;
  esac
done
[ -n "$BASE_URL" ] && [ -n "$API_KEY" ] || usage
[ "$LEVEL" = "boot" ] || [ "$LEVEL" = "full" ] || usage
if [ -z "$DENIED_FILE" ]; then DENIED_FILE="$(dirname "$0")/models-denied.json"; fi
[ -f "$DENIED_FILE" ] || { echo "FAIL: denied file 缺失: $DENIED_FILE"; exit 1; }

echo "healthcheck target: $BASE_URL (level=$LEVEL)"
PASS=1
fail() { echo "FAIL: $1"; PASS=0; }

# 就绪（最多等 3 分钟）
READY=""
for i in $(seq 1 18); do
  sleep 10
  C0="$(curl -s -m 8 -o /dev/null -w '%{http_code}' "$BASE_URL/v1/models" || echo 000)"
  echo "ready-probe#$i -> $C0"
  if [ "$C0" = "200" ]; then READY=1; break; fi
done
if [ -z "$READY" ]; then
  echo "FAIL: canary 3 分钟未就绪"
  [ -n "$CONTAINER" ] && docker logs "$CONTAINER" --tail 60 2>/dev/null || true
  exit 1
fi

probe_chat() { # $1=key $2=outfile -> http code
  curl -s -m 30 -o "$2" -w '%{http_code}' \
    -H "Authorization: Bearer $1" -H 'Content-Type: application/json' \
    -d '{"model":"muse-spark-1.3-contributor","messages":[{"role":"user","content":"hi"}],"max_tokens":1}' \
    "$BASE_URL/v1/chat/completions" || echo 000
}

if [ "$LEVEL" = "full" ]; then
CC="$(probe_chat "$API_KEY" /tmp/hc-cc.json)"
echo "verify: real-key=$CC $(head -c 120 /tmp/hc-cc.json)"
if grep -qi "no.connected.db\|no_db_connection" /tmp/hc-cc.json 2>/dev/null; then
  fail "real key 透出 No connected db"
elif [ "$CC" = "200" ]; then
  python3 -c "import json;d=json.load(open('/tmp/hc-cc.json'));assert isinstance(d['choices'][0]['message']['content'],str)" || fail "回包格式错"
elif [ "$CC" = "400" ] && grep -qi "does not support this protocol" /tmp/hc-cc.json; then
  : # 上游形：模型只支持 responses API
elif { [ "$CC" = "401" ] || [ "$CC" = "403" ]; } && grep -qi "upstream request failed" /tmp/hc-cc.json; then
  : # 上游形：key 被上游拒
else
  fail "意外状态码 $CC"
fi

IC="$(probe_chat "sk-invalid-test" /tmp/hc-ic.json)"
echo "verify: fake-key=$IC $(head -c 120 /tmp/hc-ic.json)"
if grep -qi "no.connected.db\|no_db_connection" /tmp/hc-ic.json 2>/dev/null; then
  fail "fake key 透出 No connected db"
elif { [ "$IC" = "401" ] || [ "$IC" = "403" ]; } && grep -qi "upstream request failed" /tmp/hc-ic.json; then
  : # OK：杂 key 透回上游 verdict
else
  fail "fake key 未透传上游"
fi
fi # PROBE_LEVEL=full（真假 key 上游 verdict 只在细测跑；生产轻链路只验就绪+黑名单）

# 黑名单（denied 文件首条应 400，由 vault guard 拦，非上游）
DENIED="$(python3 -c "import json;print(json.load(open('$DENIED_FILE'))[0])")"
BL="$(curl -s -m 30 -o /tmp/hc-bl.json -w '%{http_code}' \
  -H "Authorization: Bearer $API_KEY" -H 'Content-Type: application/json' \
  -d "{\"model\":\"$DENIED\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1}" \
  "$BASE_URL/v1/chat/completions" || echo 000)"
echo "verify: denied($DENIED)=$BL $(head -c 120 /tmp/hc-bl.json)"
if [ "$BL" != "400" ]; then fail "黑名单未拦"; fi

if [ "$PASS" = "1" ]; then echo "PROBE OK"; else [ -n "$CONTAINER" ] && docker logs "$CONTAINER" --tail 60 2>/dev/null || true; exit 1; fi
