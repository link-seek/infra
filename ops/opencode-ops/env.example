# /etc/opencode-ops/.env —— 由 .github/workflows/opencode-ops-deploy.yml 从组织级 secrets 渲染（chmod 600）
# 本文件是样例；真实值不进仓库。
# 镜像：仓库名 + tag（digest pin 建议用 @sha256，tag 用 VERSION 单点）
OPENCODE_OPS_REPO=opencode-ops
OPENCODE_OPS_TAG=2.3.0
# 绑定地址：默认只绑 tailscale IP（不暴露 eth0/公网）。如需 0.0.0.0 自行改。
OPENCODE_OPS_BIND=100.100.246.95
# 模型网关（公网可达）
LITELLM_BASE_URL=https://litellm.linkseek.net.cn/v1
LITELLM_API_KEY=
# OpenCode Web 口令（组织 secret PROD_OPENCODE_SERVER_PASSWORD）
OPENCODE_SERVER_PASSWORD=
# 华为云（组织 secret PROD_HCLOUD_AK/SK，或专用 OPS_HCLOUD_AK/SK）
HCLOUD_REGION=cn-north-4
HCLOUD_AK=
HCLOUD_SK=
# Git（组织 secret AGENT_GITHUB_TOKEN）
GH_TOKEN=
GIT_AUTHOR_NAME=opencode-ops
GIT_AUTHOR_EMAIL=opencode-ops@local
