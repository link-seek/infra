# 后端 hw21:4097
opencode.xieyucheng.top {
	reverse_proxy {
		dynamic a {
			name mesh-hw-21.mackarel-polaris.ts.net.
			port 4097
			refresh 5s
			resolvers 100.100.100.100
		}
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/opencode.log
	}
}

# mesh-ali-gz 入口 opencode.yingxin.net.cn：Caddy → tailnet → hw41:4097（容器在 hw41）
# 后端用 MagicDNS 全称＋dynamic a（refresh 5s＋被动健康检查；deliver-caddy 保证本机首选 100.100.100.100）。
opencode.yingxin.net.cn {
	reverse_proxy {
		dynamic a {
			name mesh-hw-41.mackarel-polaris.ts.net.
			port 4097
			refresh 5s
			resolvers 100.100.100.100
		}
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/opencode-yingxin.log
	}
}

# 网关公网入口（2026-11-03 灰云直连）：Caddy → 独立 tailnet 身份 litellm-gateway:4000。
# 国内直连：用户→广州 ali-gz→tailnet→华北网关。隧道回滚已删。
# 模型列表实时透传官方（无 cron 无过滤）：/go/v1/models → Go 订阅清单；/v1/models → 余额清单。
litellm.linkseek.net.cn {
	@goList {
		method GET
		path /go/v1/models*
	}
	handle @goList {
		rewrite * /inference/go/v1/models
		reverse_proxy https://opencode.ai {
			header_up Host opencode.ai
			header_up -Authorization
			header_up -X-Api-Key
		}
	}
	@zenList {
		method GET
		path /v1/models*
	}
	handle @zenList {
		rewrite * /inference/v1/models
		reverse_proxy https://opencode.ai {
			header_up Host opencode.ai
			header_up -Authorization
			header_up -X-Api-Key
		}
	}
	reverse_proxy {
		dynamic a {
			name litellm-gateway.mackarel-polaris.ts.net.
			port 4000
			refresh 5s
			resolvers 100.100.100.100
		}
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/litellm.log
	}
}

