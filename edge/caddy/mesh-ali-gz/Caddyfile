# 后端 k3s xieyucheng pod（2026-11-14 切流；回滚=改回 mesh-hw-21 即发）
opencode.xieyucheng.top {
	reverse_proxy {
		dynamic a {
			name opencode-xieyucheng.mackarel-polaris.ts.net.
			port 4097
			refresh 5s
			resolvers 100.100.100.100
		}
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/opencode.log
	}
}

# mesh-ali-gz 入口 opencode.yingxin.net.cn：Caddy → tailnet → k3s pod（P4 直切，2026-11-12）。
# 旧后端 hw41:4097 保留 7 天（compose 栈原地不动，回滚=改回即发）；7 天无异常再下。
# 后端用 MagicDNS 全称＋dynamic a（refresh 5s＋被动健康检查；deliver-caddy 保证本机首选 100.100.100.100）。
opencode.yingxin.net.cn {
	reverse_proxy {
		dynamic a {
			name opencode-k3s.mackarel-polaris.ts.net.
			port 4097
			refresh 5s
			resolvers 100.100.100.100
		}
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/opencode-yingxin.log
	}
}

# 网关公网入口（2026-11-03 灰云直连）：Caddy → 独立 tailnet 身份 litellm-gateway:4000。
# 国内直连：用户→广州 ali-gz→tailnet→华北网关。隧道回滚已删。
# 模型列表实时透传官方（无 cron 无过滤）：/go/v1/models → Go 订阅清单；/v1/models → 余额清单。
litellm.linkseek.net.cn {
	@goList {
		method GET
		path /go/v1/models*
	}
	handle @goList {
		rewrite * /inference/go/v1/models
		reverse_proxy https://opencode.ai {
			header_up Host opencode.ai
			header_up -Authorization
			header_up -X-Api-Key
		}
	}
	@zenList {
		method GET
		path /v1/models*
	}
	handle @zenList {
		rewrite * /inference/v1/models
		reverse_proxy https://opencode.ai {
			header_up Host opencode.ai
			header_up -Authorization
			header_up -X-Api-Key
		}
	}
	reverse_proxy {
		# #423 步骤三：域名直切 k3s（2026-11-14）。后端 = k3s 网关 tailnet 身份（tag:gateway 已放行，无需 ACL 变更）。
		# 回滚：改回 dynamic litellm-gateway.mackarel-polaris.ts.net.:4000（HW21 单后端）。
		dynamic a {
			name litellm-gateway-k3s.mackarel-polaris.ts.net.
			port 4000
			refresh 5s
			resolvers 100.100.100.100
		}
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/litellm.log
	}
}
