			name cfos-demo.mackarel-polaris.ts.net.
			port 8788
			refresh 5s
			resolvers 100.100.100.100
		}
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/cfos-demo.log
	}
}
