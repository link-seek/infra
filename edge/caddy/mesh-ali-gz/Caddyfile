# 后端 k3s xieyucheng：单代理 ha-a（钉 41，与 pod 同节点；ha-b 已摘，2026-11-19）。
# 健康检查保留：pod 重建窗口内摘掉后端，不让用户撞 502。
# 回滚=加回 ha-b dynamic 块（见 git 历史）。
opencode.xieyucheng.top {
	reverse_proxy {
		dynamic a {
			name opencode-xieyucheng-ha-a.mackarel-polaris.ts.net.
			port 4097
			refresh 5s
			resolvers 100.100.100.100
		}
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
		# 主动健康检查：后端 pod 重建窗口内摘掉它，不让用户撞 502。
		health_uri /
		health_interval 10s
		health_timeout 5s
	}
	# 注：本机 caddy 为定制构建，不支持 handle_error/status matcher，维护页不上；
	# 后端全死时仍是空 502/503（与之前一致）。
	log {
		output file /var/log/caddy/opencode.log
	}
}

# mesh-ali-gz 入口 opencode.yingxin.net.cn：Caddy → tailnet → k3s pod（P4 直切，2026-11-12）。
# 旧后端 hw41:4097 保留 7 天（compose 栈原地不动，回滚=改回即发）；7 天无异常再下。
# 后端用 MagicDNS 全称＋dynamic a（refresh 5s＋被动健康检查；deliver-caddy 保证本机首选 100.100.100.100）。
# yingxin 公测：Caddy 只终结 TLS，后端改指 Traefik 的 TS 代理（operator 暴露，Host 透传）。
# 回滚=改回 dynamic 块（见 git 历史）。无主动检查（探活 Host 不对会 404 误判，只用被动熔断）。
opencode.yingxin.net.cn {
	reverse_proxy {
		# 单后端：经 Traefik（旧名被占，-1 为现行名；哪天重建抢回干净名再改回）。
		to http://traefik-edge.mackarel-polaris.ts.net:8080
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/opencode-yingxin.log
	}
}

# 部门共用实例 team-agent（trial，单后端；稳定后再议 ha）。ops 习惯叫 agent，2026-11-16 改名（旧 opencode-team.xieyucheng.top 同 day 退役）。
# 后端 = k8s 独立 browserless 旁的 opencode-team Pod（operator 代理，ha-b 钉 .69）。
# 回滚=删本段（DNS 另清）；opencode 自带密码门，公网直达无妨。
# team-agent 试点：Caddy 只终结 TLS，后端改指 Traefik 的 TS 代理（operator 暴露，Host 透传）。
# 回滚=改回 dynamic 块（见 git 历史）。切流完成即删本段（Traefik 接管 443）。
team-agent.xieyucheng.top {
	reverse_proxy {
		to http://traefik-edge.mackarel-polaris.ts.net:8080
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
		# 无主动检查：Traefik 按 Host 路由，探活 Host 不对会 404 误判；只用被动熔断（真实请求 Host 正确）。
	}
	log {
		output file /var/log/caddy/team-agent.log
	}
}

# 网关公网入口（2026-11-03 灰云直连）：Caddy → 独立 tailnet 身份 litellm-gateway:4000。
# 国内直连：用户→广州 ali-gz→tailnet→华北网关。隧道回滚已删。
# 模型列表实时透传官方（无 cron 无过滤）：/go/v1/models → Go 订阅清单；/v1/models → 余额清单。
litellm.linkseek.net.cn {
	@goList {
		method GET
		path /go/v1/models*
	}
	handle @goList {
		rewrite * /inference/go/v1/models
		reverse_proxy https://opencode.ai {
			header_up Host opencode.ai
			header_up -Authorization
			header_up -X-Api-Key
		}
	}
	@zenList {
		method GET
		path /v1/models*
	}
	handle @zenList {
		rewrite * /inference/v1/models
		reverse_proxy https://opencode.ai {
			header_up Host opencode.ai
			header_up -Authorization
			header_up -X-Api-Key
		}
	}
	reverse_proxy {
		# #423 步骤三：域名直切 k3s（2026-11-14）。后端 = k3s 网关 tailnet 身份（tag:gateway 已放行，无需 ACL 变更）。
		# 回滚：改回 dynamic litellm-gateway.mackarel-polaris.ts.net.:4000（HW21 单后端）。
		dynamic a {
			name litellm-gateway-k3s.mackarel-polaris.ts.net.
			port 4000
			refresh 5s
			resolvers 100.100.100.100
		}
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/litellm.log
	}
}

# ERPNext trial（单后端 ha-b 钉 .69；稳定后再议 ha）。
# 后端 = k8s erpnext Service 经 tailscale operator 暴露（hostname erpnext，proxy-class ha-b，端口 8080）。
# 主动健康检查不上：frappe 无站点时 / 与 /api/method/ping 均非 200（404），会被误摘；
# 只用被动熔断（fail_duration/max_fails，与 opencode.yingxin 块同 pattern）。
# 回滚=删本段（DNS 另清）；首登需 admin 密码（Secret erpnext，不进仓）。
# erp 试点：Caddy 只终结 TLS，后端改指 Traefik 的 TS 代理（operator 暴露，Host 透传）。
# 回滚=改回 dynamic 块（见 git 历史）。主动健康检查不上（frappe 非 200 误摘，Caddy 侧沿用被动熔断）。
erp.xieyucheng.top {
	reverse_proxy {
		to http://traefik-edge.mackarel-polaris.ts.net:8080
		fail_duration 30s
		max_fails 2
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/erp.log
	}
}
